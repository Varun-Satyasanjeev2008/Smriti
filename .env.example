# ------------------------------------------------------------------------------
# Groq API — used by the AGENT for patent relevance reasoning
# Get a key at: https://console.groq.com
# ------------------------------------------------------------------------------
GROQ_API_KEY=<key_here>

# Optional: override the model used for agent reasoning
# Default: openai/gpt-oss-120b (llama-3.3-70b-versatile was deprecated by Groq on 2026-08-16)
# GROQ_MODEL=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Hindsight memory system — LLM provider for Hindsight's INTERNAL reasoning
# These are passed directly to the Hindsight Docker container.
# Hindsight supports: openai, groq, anthropic, gemini, ollama, bedrock, etc.
# You may reuse your Groq credentials here, or use a different provider.
# ------------------------------------------------------------------------------
HINDSIGHT_API_LLM_PROVIDER=groq
HINDSIGHT_API_LLM_API_KEY=<key_here>

# Optional: override the model Hindsight uses internally
# Default: openai/gpt-oss-120b (when provider=groq)
# HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-120b

# URL where the agent connects to Hindsight REST API.
# In Docker Compose this is http://hindsight:8888; change for external deployments.
HINDSIGHT_URL=http://hindsight:8888

# ------------------------------------------------------------------------------
# App-level PostgreSQL (pgvector) — for patent cache and request logs
# Do NOT use this DB for Hindsight; Hindsight has its own embedded Postgres.
# ------------------------------------------------------------------------------
POSTGRES_USER=patentuser
POSTGRES_PASSWORD=patentpass
POSTGRES_DB=patentdb

# The full async connection URL (used by the agent service inside Docker).
# You normally do NOT need to change this if using docker-compose defaults.
APP_DATABASE_URL=postgresql+asyncpg://patentuser:patentpass@db:5432/patentdb

# ------------------------------------------------------------------------------
# Application settings
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

# Set to "true" to echo all SQL statements (useful for debugging)
# SQL_ECHO=false
